<?xml version="1.0" encoding="utf-8"?>
<!-- Based on Unity's UnityManifest.xml (GameActivity entry only) + the Mobile Wallet Adapter package-visibility query. -->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Android 11+ package visibility: lets the app see Mobile Wallet Adapter wallets -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="solana-wallet" />
        </intent>
    </queries>
    <application>
        <activity android:name="com.unity3d.player.UnityPlayerGameActivity"
                  android:exported="true"
                  android:theme="@style/BaseUnityGameActivityTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Room invites. App Link: https://kartcup.bharadwaj465.workers.dev/r/CODE, verified against the
                 /.well-known/assetlinks.json the Worker already serves for Mobile Wallet Adapter. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="kartcup.bharadwaj465.workers.dev" android:pathPrefix="/r" />
            </intent-filter>
            <!-- Fallback the invite page's intent:// button uses when the https link is not verified: kartcup://r/CODE -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kartcup" android:host="r" />
            </intent-filter>
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
            <meta-data android:name="android.app.lib_name" android:value="game" />
        </activity>
    </application>
</manifest>
